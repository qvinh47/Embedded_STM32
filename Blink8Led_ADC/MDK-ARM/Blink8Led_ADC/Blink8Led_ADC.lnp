"blink8led_adc\stm32f1xx_hal_rcc.o"
"blink8led_adc\stm32f1xx_hal_rcc_ex.o"
"blink8led_adc\stm32f1xx_hal_gpio.o"
"blink8led_adc\stm32f1xx_hal_dma.o"
